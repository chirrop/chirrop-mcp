  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "chirrop",
    "mcp",
    "model-context-protocol",
    "monitoring",
    "analytics"
  ],
  "license": "MIT",
  "author": "ChirrOp",
  "repository": {
    "type": "git",
    "url": "https://github.com/chirrop/chirrop-mcp"
