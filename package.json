{
  "name": "@chirropjs/chirrop-mcp",
  "version": "0.2.0",
  "description": "MCP server for the ChirrOp monitoring platform",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "chirrop-mcp": "dist/index.js"
  },
  "files": [
